# Path to Ortho — optional deployment overrides for the built-in 2026–2027 cycle.
# Values must be real calendar dates in YYYY-MM-DD format. Omit them to use the
# version-controlled defaults in src/lib/path-to-ortho/application-cycle.ts.
# NEXT_PUBLIC_PATH_TO_ORTHO_ERAS_APPLICATION_OPEN_DATE=2026-09-02
# NEXT_PUBLIC_PATH_TO_ORTHO_ERAS_PROGRAM_REVIEW_DATE=2026-09-23
# NEXT_PUBLIC_PATH_TO_ORTHO_NRMP_REGISTRATION_OPEN_DATE=2026-09-15
# NEXT_PUBLIC_PATH_TO_ORTHO_NRMP_REGISTRATION_CLOSE_DATE=2027-01-29
# NEXT_PUBLIC_PATH_TO_ORTHO_NRMP_RANKING_OPEN_DATE=2027-02-01
# NEXT_PUBLIC_PATH_TO_ORTHO_NRMP_RANKING_CLOSE_DATE=2027-03-03
# NEXT_PUBLIC_PATH_TO_ORTHO_YES_NO_DAY_DATE=2027-03-15
# NEXT_PUBLIC_PATH_TO_ORTHO_MATCH_DAY_DATE=2027-03-19

# Website-only CasePrep v1.1 preview. The CasePrep service must separately set
# ENABLE_CASEPREP_WEB_V1_1=true. Leave false to keep every web caller on existing flows.
CASEPREP_WEB_V1_1_ENABLED=false
CASEPREP_WEB_V1_1_STREAM_ENABLED=false

# Grounded CasePrep v1.2. Enable all three together after the CasePrep service
# has ENABLE_CASEPREP_WEB_V1_2_STREAM=true. Disable the NEXT_PUBLIC flag for
# immediate client rollback to v1.1 without changing stored data.
CASEPREP_WEB_V1_2_STREAM_ENABLED=false
NEXT_PUBLIC_CASEPREP_V1_2_ENABLED=false

# RAG + approach-library CasePrep v1.3. Curated procedure packets remain off
# this path and are reserved for a later version.
CASEPREP_WEB_V1_3_STREAM_ENABLED=false
NEXT_PUBLIC_CASEPREP_V1_3_ENABLED=false

# Branch attribution. The public key powers the browser SDK; BRANCH_KEY is the
# same environment-specific key used by authoritative subscription webhooks.
NEXT_PUBLIC_BRANCH_KEY=
BRANCH_KEY=

# CasePrep High-Yield References discovers Orthobullets and AO resources from
# their public first-party search/sitemap indexes; no web-search account or key
# is required. PubMed also works without a key, while NCBI recommends the
# optional identification below for production and higher request rates.
# NCBI_TOOL=snaportho-caseprep-references
# NCBI_EMAIL=
# NCBI_API_KEY=

# -----------------------------------------------------------------------------
# Sign-out tracker encryption (docs/signout-tracker-plan-2026-08-05.md).
# Card bodies and quarantined identifiers are AES-256-GCM encrypted in the app.
# SIGNOUT_KEY_ID is the epoch that NEW rows are written under. For each scope,
# provide the matching 32-byte key as base64 in SIGNOUT_KEY_<SCOPE>_<ID> (the id
# uppercased with non-alphanumerics -> underscore). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep old keys present after rotating SIGNOUT_KEY_ID so existing rows still open.
# SIGNOUT_KEY_ID=2026-08
# SIGNOUT_KEY_CARD_2026_08=<base64-32-bytes>
# SIGNOUT_KEY_IDENTIFIER_2026_08=<base64-32-bytes>
GOOGLE_PROGRAM_CALENDAR_REDIRECT_URI=https://snap-ortho.com/api/program/calendar-source/callback
GOOGLE_PROGRAM_CALENDAR_WEBHOOK_URL=https://snap-ortho.com/api/integrations/google/calendar-webhook
# Generate with: openssl rand -base64 32
PROGRAM_CALENDAR_TOKEN_ENCRYPTION_KEY=
